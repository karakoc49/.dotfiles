{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    // Sol, Orta ve Sağ Modüller
    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock", "custom/claude"],
    "modules-right": ["bluetooth", "pulseaudio", "network", "cpu", "memory", "battery", "tray"],

    // Sway Workspaces Modülü
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

    // Aktif Pencere Başlığı
    "sway/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // Sistem Tepsisi
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    // Saat & Tarih
    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // CPU
    "cpu": {
        "format": " {usage}%",
        "tooltip": true
    },

    // RAM
    "memory": {
        "format": " {}%"
    },

    // Ağ Durumu
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    // Ses Düzeyi (PipeWire/PulseAudio)
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    // Pil Durumu
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "~/.local/bin/waybar-claude.py",
        "on-click": "alacritty -e claude"
    },

    "bluetooth": {
        "format": "",
        "format-connected": "󰂯 {device_alias} {device_battery_percentage}%",
        "format-connected-battery": "󰂯 {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{num_connections} cihaz bağlı",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} cihaz bağlı\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address} {device_battery_percentage}%",
        "on-click": "alacritty -e bluetoothctl"
    }
}
