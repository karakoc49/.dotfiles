# ==============================================================================
# HALUK'S SWAY CONFIG (Fedora 44 Wayland - Rosé Pine Theme Integrated)
# ==============================================================================

# --- Değişkenler ---
set $mod Mod1
set $term alacritty
set $menu rofi -show drun
set $filemgr nautilus --new-window
set $browser google-chrome --enable-features=UseOzonePlatform --ozone-platform=wayland --new-window

# --- Rosé Pine Renk Tanımları ---
set $base          #191724
set $surface       #1f1d2e
set $overlay       #26233a
set $muted         #6e6a86
set $subtle        #908caa
set $text          #e0def4
set $love          #eb6f92
set $gold          #f6c177
set $rose          #ebbcba
set $pine          #31748f
set $foam          #9ccfd8
set $iris          #c4a7e7
set $highlight_low #21202e
set $highlight_med #403d52
set $highlight_high #524f67

font pango:Iosevka Nerd Font 10

gaps inner 12
gaps outer 6
smart_gaps off
smart_borders off
default_border pixel 2

workspace_layout default
default_orientation horizontal

# --- Rosé Pine Pencere Renk Giydirmesi ---
# class                 border    bg        text     indicator child_border
client.focused          $iris     $base     $text    $rose     $iris
client.focused_inactive $overlay  $base     $subtle  $overlay  $overlay
client.unfocused        $surface  $base     $muted   $surface  $surface
client.urgent           $love     $love     $base    $love     $love
client.placeholder      $overlay  $base     $text    $overlay  $overlay

# --- Klavye ve Touchpad ---
input * {
    xkb_layout "tr"
    tap enabled
    natural_scroll disabled
}

# --- Monitör Ayarları ---
output eDP-1 res 1920x1080@60Hz pos 0 0
output DP-3 res 2560x1440@179.952Hz pos 1920 0
output HDMI-A-1 res 1920x1080@180.003Hz pos 1920 0

# --- Duvar Kağıdı ---
output * bg /home/haluk/.dotfiles/wallpapers/jms-kFHz9Xh3PPU-unsplash.jpg fill

# --- Autostart & Servisler ---
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user start sway-session.target
exec /usr/libexec/polkit-mate-authentication-agent-1 || /usr/libexec/lxpolkit
exec_always nm-applet --indicator
exec_always blueman-applet
exec udiskie --tray
exec gnome-keyring-daemon --start
exec dbus-update-activation-environment --systemd SSH_AUTH_SOCK GNOME_KEYRING_CONTROL GNOME_KEYRING_PID
exec_always ~/.local/bin/autotiling
exec mako
exec solaar --window=hide

# --- GTK & Dark Theme Yapılandırması ---
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface font-name 'Adwaita Sans 11'
    dbus-update-activation-environment --systemd GTK_THEME=Adwaita-dark QT_STYLE_OVERRIDE=adwaita-dark
}

# --- D-Bus, Portal ve Karanlık Tema Yapılandırması ---
exec {
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    systemctl --user restart xdg-desktop-portal xdg-desktop-portal-gtk
}

# --- Kısayollar ---
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+q kill
bindsym $mod+Shift+f exec $filemgr
bindsym $mod+Shift+w exec $browser

# Odak (Vim + Yön Tuşları)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Taşıma (Vim + Yön Tuşları)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus_mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# ==============================================================================
# WORKSPACE MONİTÖR EŞLEŞTİRMELERİ
# ==============================================================================

# Workspace 1 -> Laptop Ekranı (eDP-1)
workspace $ws1 output eDP-1

# Workspace 2 - 10 -> Harici Monitörler (Öncelik: Ofis DP-3, Sonra Ev HDMI-A-1)
workspace $ws2 output DP-3 HDMI-A-1
workspace $ws3 output DP-3 HDMI-A-1
workspace $ws4 output DP-3 HDMI-A-1
workspace $ws5 output DP-3 HDMI-A-1
workspace $ws6 output DP-3 HDMI-A-1
workspace $ws7 output DP-3 HDMI-A-1
workspace $ws8 output DP-3 HDMI-A-1
workspace $ws9 output DP-3 HDMI-A-1
workspace $ws10 output DP-3 HDMI-A-1

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload & Exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec ~/.config/rofi/powermenu.sh

# Ekranı Kilitleme Kısayolu (Mod + Esc)
bindsym $mod+Escape exec PAM_SERVICE=passwd gtklock -d

# Donanım
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

bindsym Print exec grim -g "$(slurp)" - | tee ~/Pictures/Screenshot_$(date +%Y-%m-%d-%H%M%S).png | wl-copy

# Bar
bar {
    swaybar_command waybar
}


# --- Chrome Ekran Paylaşımı Popup'ını Scratchpad'e Gizle ---
for_window [title=".*is sharing your screen.*"] floating enable, move to scratchpad
